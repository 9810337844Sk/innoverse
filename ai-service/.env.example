# ============================================
# AI Service Environment Variables
# ============================================

# ============================================
# LOCAL DEVELOPMENT (localhost)
# ============================================
# URL of the Next.js app — used as the default callback for face indexing
APP_URL=http://localhost:3000

# ============================================
# PRODUCTION (Deployed URLs - Uncomment when deploying)
# ============================================
# APP_URL=https://your-app.vercel.app

# ============================================
# Security
# ============================================
# Shared secret so the callback route can verify requests come from this service
# This MUST match the INTERNAL_SECRET in frontend .env
INTERNAL_SECRET=change-me-to-a-random-string
